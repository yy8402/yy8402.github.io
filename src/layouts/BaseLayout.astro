---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Yuyang Yang",
  description = "Notes on AI workspaces, software architecture, and applied engineering.",
} = Astro.props;

const pageTitle = title === "Yuyang Yang" ? title : `${title} | Yuyang Yang`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <a href="https://github.com/yy8402" rel="me noopener" target="_blank">
        yy8402 @ GitHub
      </a>
    </footer>
  </body>
</html>
